DBO_ENVIRONMENT=development
DBO_DATA_DIR=./data
DBO_SQLITE_BUSY_TIMEOUT_MS=3000
DBO_PUBLIC_ORIGIN=http://localhost:3000
DBO_ALLOW_INSECURE_COOKIES=true
# Also enables semantic history search (gemini-embedding-001); empty disables provider features.
DBO_GEMINI_API_KEY=
# Gemini key/model and provider/query timeouts reload on the next local analysis request.
DBO_GEMINI_MODEL=gemini-3.8-flash
# Planning fallback order: Gemini -> OpenRouter -> Groq; blank keys skip providers.
# Embeddings remain Gemini-only. Models must support JSON object output.
DBO_OPENROUTER_API_KEY=
DBO_OPENROUTER_MODEL=openai/gpt-4o-mini
DBO_GROQ_API_KEY=
DBO_GROQ_MODEL=openai/gpt-oss-120b
DBO_PROVIDER_TIMEOUT_SECONDS=30
DBO_QUERY_TIMEOUT_SECONDS=5
